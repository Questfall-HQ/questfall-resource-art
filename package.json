{
  "name": "@questfall/resource-art",
  "version": "2.16.0",
  "private": true,
  "type": "module",
  "description": "Shared resource artwork and Founder NFT images and animations for Questfall Application and Admin",
  "types": "./catalog.d.ts",
  "exports": {
    ".": {
